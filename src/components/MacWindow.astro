---
interface Props {
  title?: string;
  variant?: "ink" | "paper";
}

const { title = "Turnout", variant = "ink" } = Astro.props;
---

<div class:list={["mac-window", variant === "paper" && "mac-window-paper"]}>
  <div class="mac-window-bar">
    <span class="mac-traffic" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span class="mac-window-title">{title}</span>
  </div>
  <div class="mac-window-body">
    <slot />
  </div>
</div>
