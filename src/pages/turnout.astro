---
import Base from "../layouts/Base.astro";
import MacWindow from "../components/MacWindow.astro";

const purchaseHref = "mailto:ben+website@marginalia.ventures?subject=Turnout%20for%20Mac";
const purchaseLabel = "Purchase";

const nav = [
  { href: "#features", label: "Features" },
  { href: "#pricing", label: "Pricing" },
  { href: "#faqs", label: "FAQs" },
];

const workspaces = [
  { id: "design", label: "Design", icon: "board" },
  { id: "writing", label: "Writing", icon: "doc" },
  { id: "development", label: "Development", icon: "code" },
  { id: "research", label: "Research", icon: "search" },
  { id: "meetings", label: "Meetings", icon: "users" },
];

const primaryFeatures = [
  {
    id: "save",
    title: "Save workspaces",
    body: "Turnout remembers the windows and apps for each kind of work.",
  },
  {
    id: "switch",
    title: "Switch in a moment",
    body: "Jump between projects, meetings, or tasks with one click.",
  },
  {
    id: "displays",
    title: "Works across displays",
    body: "Your layout comes back on the screen setup you left.",
  },
];

const secondaryFeatures = [
  {
    title: "Save workspaces",
    body: "Turnout remembers the windows and apps for each kind of work.",
    icon: "board",
  },
  {
    title: "Switch in a moment",
    body: "Jump between projects, meetings, or tasks with one click.",
    icon: "swap",
  },
  {
    title: "Works across displays",
    body: "Your layout comes back on the screen setup you left.",
    icon: "display",
  },
  {
    title: "Stay in flow",
    body: "Less time arranging windows. More time on the work.",
    icon: "focus",
  },
  {
    title: "Restore the apps",
    body: "The same apps open in the same place, ready to use.",
    icon: "apps",
  },
  {
    title: "Yours forever",
    body: "One purchase. No subscription. Updates stay with the app.",
    icon: "key",
  },
];

const included = [
  "Unlimited workspaces",
  "Restore windows and apps",
  "Multiple display support",
  "macOS 14 or later",
  "Apple Silicon and Intel",
];

const faqs = [
  {
    q: "What is Turnout?",
    a: "Turnout is a Mac app that saves the windows for each kind of work and puts them back when you switch tasks.",
  },
  {
    q: "Which Macs does it support?",
    a: "macOS 14 or later. Apple Silicon and Intel.",
  },
  {
    q: "Is this a subscription?",
    a: "No. Turnout is a one-time purchase.",
  },
  {
    q: "Can I try it first?",
    a: "A trial build is on the way. For now, write to us if you want early access.",
  },
  {
    q: "How many workspaces can I save?",
    a: "As many as you need. Design, writing, meetings, or a layout for a single project.",
  },
  {
    q: "Does it work with more than one display?",
    a: "Yes. Turnout restores the layout on the screen setup you left.",
  },
  {
    q: "How do I restore a layout?",
    a: "Pick a workspace. Turnout opens the apps and places the windows.",
  },
  {
    q: "Do I get updates?",
    a: "Yes. The purchase includes app updates.",
  },
  {
    q: "How do I get a refund?",
    a: "Write to us within 14 days of purchase. We will send a refund.",
  },
];
---

<Base
  title="Turnout — automatic workspaces for Mac"
  description="Turnout remembers what you are working on and puts the right windows in the right place. A Mac app from Marginalia Ventures."
  product="Turnout"
  ogTitle="Turnout, a Marginalia Ventures app"
  ogUrl="https://marginalia.ventures/turnout"
  nav={nav}
  cta={{ href: purchaseHref, label: purchaseLabel }}
>
  <link slot="head" rel="icon" href="/images/turnout.png" type="image/png" />

  <main id="main">
    <section class="mx-auto grid min-w-0 max-w-page gap-16 px-5 pb-20 pt-4 sm:px-8 sm:pt-6 lg:grid-cols-2 lg:items-center lg:gap-20 lg:pt-10">
      <div class="min-w-0">
        <img
          src="/images/turnout.png"
          width="64"
          height="64"
          alt=""
          class="mb-8 size-20"
        />
        <h1 class="font-display max-w-full text-[length:clamp(2.125rem,8vw,4.5rem)] text-ink">
          <span class="lg:hidden">
            Automatic
            <span class="block">workspaces</span>
            <span class="block">for Mac.</span>
          </span>
          <span class="hidden lg:block">
            <span class="block">Automatic</span>
            <span class="block">workspaces</span>
            <span class="block">for Mac.</span>
          </span>
        </h1>
        <p class="mt-8 max-w-[min(36ch,100%)] text-lg leading-relaxed text-quiet">
          Turnout remembers what you work on. It puts the right windows in the right place when you switch tasks.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            class="btn btn-solid inline-flex items-center rounded-md border px-3 py-2 text-[15px] font-medium"
            href={purchaseHref}
          >
            {purchaseLabel}
          </a>
        </div>
        <p class="mt-4 text-[15px] text-quiet">$49, one time. macOS 14 or later.</p>
      </div>

      <div class="min-w-0">
        <MacWindow title="Workspaces">
          <form class="p-1" aria-label="Choose a workspace">
            {
              workspaces.map((space, index) => (
                <label class="workspace-item relative">
                  <input type="radio" name="workspace" value={space.id} checked={index === 0} />
                  <span class="flex size-5 items-center justify-center text-paper/70" aria-hidden="true">
                    {space.icon === "board" && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <rect x="2" y="3" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.4" />
                        <path d="M6 3v10" stroke="currentColor" stroke-width="1.4" />
                      </svg>
                    )}
                    {space.icon === "doc" && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4.5 2.5h5L12 5v8.5h-7.5v-11Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                        <path d="M9.5 2.5V5H12" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                      </svg>
                    )}
                    {space.icon === "code" && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M6 4 2.5 8 6 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M10 4 13.5 8 10 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    {space.icon === "search" && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="7" cy="7" r="3.5" stroke="currentColor" stroke-width="1.4" />
                        <path d="M10 10.5 13 13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                      </svg>
                    )}
                    {space.icon === "users" && (
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="6" cy="6" r="2.2" stroke="currentColor" stroke-width="1.4" />
                        <path d="M2.8 12.5c.4-2 1.7-3 3.2-3s2.8 1 3.2 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <circle cx="11" cy="6.2" r="1.7" stroke="currentColor" stroke-width="1.4" />
                      </svg>
                    )}
                  </span>
                  <span class="text-[15px] font-medium">{space.label}</span>
                  <svg class="workspace-check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3.5 8.2 6.6 11.2 12.5 4.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </label>
              ))
            }
          </form>
        </MacWindow>
      </div>
    </section>

    <section id="features" class="band-ink scroll-mt-28 bg-ink text-paper">
      <div class="mx-auto max-w-page px-5 py-20 sm:px-8 sm:py-24">
        <div class="max-w-2xl">
          <h2 class="font-display text-[length:clamp(2rem,5vw,3.25rem)] text-paper">
            Every layout you need. Try it for yourself.
          </h2>
          <p class="mt-6 max-w-[min(42ch,100%)] text-lg leading-relaxed text-paper/70">
            Save a workspace. Switch to it later. Turnout puts the windows back.
          </p>
        </div>

        <div class="feature-stage relative mt-16">
          {
            primaryFeatures.map((feature, index) => (
              <input
                class="sr-only"
                type="radio"
                name="primary-feature"
                id={`feature-${feature.id}`}
                checked={index === 0}
              />
            ))
          }

          <div class="grid min-w-0 items-start gap-10 lg:grid-cols-2 lg:gap-16">
            <div class="feature-shots min-w-0">
              <div class="feature-shot" data-shot="save">
                <MacWindow title="Workspaces" variant="paper">
                  <ul class="flex flex-col gap-1 p-1">
                    {
                      workspaces.map((space, index) => (
                        <li
                          class:list={[
                            "flex items-center gap-3 rounded-md px-3 py-2.5 text-[15px]",
                            index === 0 ? "bg-ink/10 font-medium" : "text-quiet",
                          ]}
                        >
                          {space.label}
                        </li>
                      ))
                    }
                  </ul>
                </MacWindow>
              </div>

              <div class="feature-shot" data-shot="switch">
                <MacWindow title="Development" variant="paper">
                  <div class="p-3">
                    <div class="flex items-center justify-between gap-3">
                      <p class="text-[15px] font-medium">Development</p>
                      <span class="text-[13px] text-quiet">Active</span>
                    </div>
                    <div class="mt-4 flex items-center gap-2" aria-hidden="true">
                      <span class="flex size-8 items-center justify-center rounded-md bg-ink/10 text-xs font-semibold">&lt;/&gt;</span>
                      <span class="flex size-8 items-center justify-center rounded-md bg-ink/10 text-xs font-semibold">$</span>
                      <span class="flex size-8 items-center justify-center rounded-md bg-ink/10 text-xs font-semibold">Fg</span>
                      <span class="flex size-8 items-center justify-center rounded-md bg-ink/10 text-xs font-semibold">G</span>
                      <span class="flex size-8 items-center justify-center rounded-md bg-ink/10 text-xs font-semibold">N</span>
                    </div>
                    <p class="mt-4 text-[15px] text-quiet">Restore 6 windows</p>
                  </div>
                </MacWindow>
              </div>

              <div class="feature-shot" data-shot="displays">
                <MacWindow title="Displays" variant="paper">
                  <div class="grid grid-cols-[1.2fr_0.8fr] gap-2 p-3" aria-hidden="true">
                    <div class="rounded-md bg-ink/10 px-3 py-8 text-center text-[13px] text-quiet">
                      Main
                    </div>
                    <div class="rounded-md bg-ink/10 px-3 py-8 text-center text-[13px] text-quiet">
                      Side
                    </div>
                  </div>
                  <p class="px-4 pb-3 text-[15px] text-quiet">Two displays. Same layout.</p>
                </MacWindow>
              </div>
            </div>

            <div class="flex min-w-0 flex-col gap-1">
              {
                primaryFeatures.map((feature) => (
                  <label
                    class="feature-pick"
                    data-feature={feature.id}
                    for={`feature-${feature.id}`}
                  >
                    <span class="font-note-title block text-xl">{feature.title}</span>
                    <span class="mt-1 block max-w-[36ch] text-[15px] leading-relaxed opacity-80">
                      {feature.body}
                    </span>
                  </label>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-page px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-2xl sm:text-center">
        <h2 class="font-display text-[length:clamp(2rem,5vw,3.25rem)] text-ink">
          Less friction. More focus.
        </h2>
        <p class="mt-6 max-w-[min(42ch,100%)] text-lg leading-relaxed text-quiet sm:mx-auto">
          Design, write, or build. Turnout brings back the windows for that work.
        </p>
      </div>

      <ul class="mx-auto mt-16 grid max-w-2xl gap-12 sm:grid-cols-2 lg:max-w-none lg:grid-cols-3">
        {
          secondaryFeatures.map((feature) => (
            <li class="min-w-0">
              <span class="flex size-8 items-center text-ink" aria-hidden="true">
                {feature.icon === "board" && (
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <rect x="2" y="3" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.4" />
                    <path d="M6 3v10" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
                {feature.icon === "swap" && (
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <path d="M3 5h10M10 2l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M13 11H3M6 8l-3 3 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {feature.icon === "display" && (
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <rect x="1.5" y="3" width="8" height="6" rx="1" stroke="currentColor" stroke-width="1.4" />
                    <rect x="7.5" y="6" width="7" height="5.5" rx="1" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
                {feature.icon === "focus" && (
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.4" />
                    <circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
                {feature.icon === "apps" && (
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.4" />
                    <rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.4" />
                    <rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.4" />
                    <rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
                {feature.icon === "key" && (
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                    <circle cx="6" cy="8" r="2.5" stroke="currentColor" stroke-width="1.4" />
                    <path d="M8.2 8h5.3v2.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                )}
              </span>
              <h3 class="font-note-title mt-4 text-xl text-ink">{feature.title}</h3>
              <p class="mt-1 max-w-[36ch] text-[15px] leading-relaxed text-quiet">{feature.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band-ink bg-ink text-paper">
      <div class="mx-auto max-w-page px-5 py-20 text-center sm:px-8 sm:py-24">
        <h2 class="font-display mx-auto max-w-[16ch] text-[length:clamp(2rem,5vw,3.25rem)] text-paper">
          Get Turnout on your Mac.
        </h2>
        <p class="mx-auto mt-6 max-w-[min(36ch,100%)] text-lg leading-relaxed text-paper/70">
          One purchase. The layout you left, every time you sit down.
        </p>
        <div class="mt-8">
          <a
            class="btn btn-paper inline-flex items-center rounded-md border px-3 py-2 text-[15px] font-medium"
            href={purchaseHref}
          >
            {purchaseLabel}
          </a>
        </div>
      </div>
    </section>

    <section id="pricing" class="mx-auto max-w-page scroll-mt-28 px-5 py-20 sm:px-8 sm:py-24">
      <div class="mx-auto max-w-2xl sm:text-center">
        <h2 class="font-display text-[length:clamp(2rem,5vw,3.25rem)] text-ink">
          One price. Yours forever.
        </h2>
        <p class="mt-6 max-w-[min(42ch,100%)] text-lg leading-relaxed text-quiet sm:mx-auto">
          Pay once. Use Turnout on your Mac with no monthly fee.
        </p>
      </div>

      <div class="mx-auto mt-16 max-w-md">
        <div class="panel p-6 sm:p-8">
          <p class="text-[15px] font-medium">Turnout</p>
          <p class="font-display mt-3 text-5xl text-paper">$49</p>
          <p class="mt-2 text-[15px] text-paper/70">One-time purchase</p>
          <ul class="mt-8 flex flex-col gap-3 text-[15px]">
            {
              included.map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3.5 8.2 6.6 11.2 12.5 4.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <a
            class="btn btn-paper mt-8 inline-flex w-full items-center justify-center rounded-md border px-3 py-2 text-[15px] font-medium"
            href={purchaseHref}
          >
            {purchaseLabel}
          </a>
        </div>
      </div>
    </section>

    <section id="faqs" class="mx-auto max-w-page scroll-mt-28 px-5 pb-24 sm:px-8">
      <div class="max-w-2xl border-t border-rule pt-20 sm:pt-24">
        <h2 class="font-display text-[length:clamp(2rem,5vw,3.25rem)] text-ink">
          Frequently asked questions
        </h2>
        <p class="mt-6 max-w-[min(42ch,100%)] text-lg leading-relaxed text-quiet">
          If you have another question, write to
          <a class="inline-note break-words underline decoration-rule underline-offset-[3px]" href="mailto:ben+website@marginalia.ventures">ben+website@marginalia.ventures</a>.
        </p>
      </div>

      <ul class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          faqs.map((item) => (
            <li class="min-w-0">
              <h3 class="font-note-title text-xl text-ink">{item.q}</h3>
              <p class="mt-1 max-w-[36ch] text-[15px] leading-relaxed text-quiet">{item.a}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <footer slot="footer" class="border-t border-rule">
    <div class="mx-auto flex w-full max-w-page flex-wrap items-baseline justify-between gap-4 px-5 py-10 sm:px-8">
      <nav class="flex flex-wrap items-baseline gap-x-6 gap-y-2" aria-label="Footer">
        {
          nav.map((link) => (
            <a class="site-nav-link text-[15px]" href={link.href}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <p class="text-[15px] text-quiet">
        <a href="/" class="inline-note underline decoration-rule underline-offset-[3px]">A Marginalia Ventures app</a>
      </p>
    </div>
  </footer>
</Base>
